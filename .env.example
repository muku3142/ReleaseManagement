# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Compose reads .env from the project directory automatically; no --env-file needed.
#
#   cp .env.example .env
#   sed -i "s|^RM_CREDENTIAL_KEY=.*|RM_CREDENTIAL_KEY=$(openssl rand -base64 32)|" .env
#   sed -i "s|^RM_JWT_SECRET=.*|RM_JWT_SECRET=$(openssl rand -base64 32)|" .env
#   sed -i "s|^RAG_ADMIN_KEY=.*|RAG_ADMIN_KEY=$(openssl rand -base64 32)|" .env
#   sed -i "s|^RAG_TOOL_SIGNING_SECRET=.*|RAG_TOOL_SIGNING_SECRET=$(openssl rand -base64 32)|" .env
#
# Substitute rather than append: `>>` would leave duplicate keys in the file.
# After editing .env, apply it with:
#   docker compose -f compose.app.yaml up -d --force-recreate app

# AES-256 key for the Jira API token column. MUST decode to exactly 32 bytes —
# the app refuses to start otherwise. Changing it makes existing stored tokens
# undecryptable; users must re-enter their API token.
RM_CREDENTIAL_KEY=

# Recorded in each encryption envelope so a future rotation batch can find rows
# still on an old key. Leave at 1 unless you are actually rotating.
RM_CREDENTIAL_KEY_VERSION=1

# HS256 signing secret for session JWTs. MUST decode to at least 32 bytes.
# Changing it invalidates every active session (users simply sign in again).
RM_JWT_SECRET=

# Seeded into jira_site_config ONLY when the table is empty. Editing this later has
# no effect on an already-seeded database — change the site in the UI's Settings
# screen instead, or reset with `docker compose -f compose.app.yaml down -v`.
# Must be exactly https://<site>.atlassian.net — NO trailing slash. The app fails
# to start otherwise, rather than persisting a URL that would build malformed
# Jira request paths.
RM_JIRA_DEFAULT_BASE_URL=https://example.atlassian.net

# Active Spring profiles. 'local' is required by this stack (it serves plain HTTP,
# and AuthCookieWriter refuses cookie-secure=false outside the local profile).
# Add stub-jira to sign in with no real Jira site — it accepts exactly
# dev@example.com / valid-token and rejects everything else.
RM_PROFILES=local,stub-jira

# Host port for the app. Container always listens on 8080.
RM_PORT=8080

# Postgres password for the compose stack.
RM_DB_PASSWORD=releasemgmt

# rag-service admin key for /v1/admin; at least 32 characters, the service refuses to start otherwise.
# Whoever holds it can register client apps.
RAG_ADMIN_KEY=

# rag-service key for signing tool-call turns; at least 32 characters, the service refuses to start otherwise.
# Rotating it invalidates only tool rounds in flight; callers restart those questions.
RAG_TOOL_SIGNING_SECRET=

# Password for the `rag` Postgres role. Set before the first start, or re-run the one-off
# in docs/docker.md after changing it.
RAG_DB_PASSWORD=rag

# Host port for rag-service. Container always listens on 8081.
RAG_PORT=8081

# Host Ollama used for embeddings (default shown).
# RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Chat model on the host Ollama (pull it first: ollama pull qwen3:4b). Callers cannot choose a model.
# RAG_CHAT_MODEL=qwen3:4b
# Context window sent to Ollama; lower it if `ollama ps` does not show 100% GPU.
# RAG_CHAT_NUM_CTX=8192
# Per-request generation deadline (ISO-8601) and per-client concurrent generation limit.
# RAG_CHAT_DEADLINE=PT120S
# RAG_CHAT_MAX_IN_FLIGHT_PER_CLIENT=1
# Tool rounds per question (default 4) and per-result size cap in characters (default 8000).
# RAG_TOOL_MAX_ROUNDS=4
# RAG_TOOL_RESULT_MAX_CHARS=8000

# ReleaseManagement as a rag-service client (the assistant). Off by default; v1 is unaffected when off.
# Get the key once: POST http://localhost:8081/v1/admin/clients {"name":"releasemanagement"} with RAG_ADMIN_KEY.
# Never commit the key. Required when RM_ASSISTANT_ENABLED=true (the app refuses to start without it).
# RM_ASSISTANT_ENABLED=false
# RM_ASSISTANT_API_KEY=
# Index sweep interval (ISO-8601, default PT30M).
# RM_ASSISTANT_SWEEP_INTERVAL=PT30M
