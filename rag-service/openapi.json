{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "rag-service",
    "description" : "Domain-free retrieval service: collections, documents, semantic search. Client routes take a client API key; /v1/admin routes take the admin key. Both as 'Authorization: Bearer <key>'.",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "security" : [ {
    "bearerKey" : [ ]
  } ],
  "paths" : {
    "/v1/collections/{collection}" : {
      "get" : {
        "tags" : [ "collection-controller" ],
        "operationId" : "get",
        "parameters" : [ {
          "name" : "collection",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "[A-Za-z0-9._:-]{1,200}"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CollectionResponse"
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "collection-controller" ],
        "operationId" : "put",
        "parameters" : [ {
          "name" : "collection",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "[A-Za-z0-9._:-]{1,200}"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PutCollectionRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CollectionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/collections/{collection}/documents/{documentId}" : {
      "get" : {
        "tags" : [ "document-controller" ],
        "operationId" : "get_1",
        "parameters" : [ {
          "name" : "collection",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "[A-Za-z0-9._:-]{1,200}"
          }
        }, {
          "name" : "documentId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "[A-Za-z0-9._:-]{1,200}"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DocumentResponse"
                }
              }
            }
