  "components" : {
    "schemas" : {
      "PutCollectionRequest" : {
        "type" : "object",
        "properties" : {
          "embeddingModel" : {
            "type" : "string"
          }
        }
      },
      "CollectionResponse" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "embeddingModel" : {
            "type" : "string"
          },
          "pending" : {
            "type" : "integer",
            "format" : "int64"
          },
          "indexed" : {
            "type" : "integer",
            "format" : "int64"
          },
          "failed" : {
            "type" : "integer",
            "format" : "int64"
          },
          "lastIndexedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "PutDocumentRequest" : {
        "type" : "object",
        "properties" : {
          "title" : {
            "type" : "string",
            "minLength" : 1
          },
          "text" : {
            "type" : "string"
          },
          "url" : {
            "type" : "string",
            "pattern" : "https?://\\S{1,2040}"
          },
          "metadata" : {
            "type" : "object",
            "additionalProperties" : { }
          }
        },
        "required" : [ "text", "title" ]
      },
      "PushResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PENDING", "INDEXED", "FAILED" ]
          }
        }
      },
      "TransformRequest" : {
        "type" : "object",
        "properties" : {
          "text" : {
            "type" : "string",
            "minLength" : 1
          },
          "instruction" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "instruction", "text" ]
      },
      "SearchRequest" : {
        "type" : "object",
        "properties" : {
          "query" : {
            "type" : "string",
            "maxLength" : 2000,
            "minLength" : 0
          },
          "filter" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "k" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "query" ]
      },
      "Hit" : {
        "type" : "object",
        "properties" : {
          "documentId" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "url" : {
            "type" : "string"
          },
          "metadata" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "chunkIndex" : {
            "type" : "integer",
            "format" : "int32"
          },
          "text" : {
            "type" : "string"
          },
          "score" : {
            "type" : "number",
            "format" : "double"
          }
        }
      },
      "SearchResponse" : {
        "type" : "object",
        "properties" : {
          "results" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Hit"
            }
          }
        }
      },
      "ReindexResponse" : {
        "type" : "object",
        "properties" : {
          "requeued" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "ChatRequest" : {
        "type" : "object",
        "properties" : {
          "collections" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "pattern" : "[A-Za-z0-9._:-]{1,200}"
            },
            "maxItems" : 10,
            "minItems" : 0
          },
          "question" : {
            "type" : "string",
            "minLength" : 1
          },
          "history" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Turn"
            }
          },
          "filter" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "k" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "collections", "question" ]
      },
      "Turn" : {
        "type" : "object",
        "properties" : {
          "role" : {
            "type" : "string",
            "pattern" : "user|assistant"
          },
          "content" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "content", "role" ]
      },
      "CreateClientRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "[A-Za-z0-9._-]{1,100}"
          }
        },
        "required" : [ "name" ]
      },
      "IssuedKeyResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "apiKey" : {
            "type" : "string"
          }
        }
      },
      "StatusResponse" : {
        "type" : "object",
        "properties" : {
          "ollama" : {
            "type" : "string"
          },
          "pending" : {
            "type" : "integer",
            "format" : "int64"
          },
          "failed" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "DocumentResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "url" : {
            "type" : "string"
          },
          "metadata" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PENDING", "INDEXED", "FAILED" ]
          },
          "statusReason" : {
            "type" : "string"
          },
          "indexedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "ClientResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "revokedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "lastUsedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerKey" : {
        "type" : "http",
        "scheme" : "bearer"
      }
    }
  }
}
