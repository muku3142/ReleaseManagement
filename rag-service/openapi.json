        }
      },
      "put" : {
        "tags" : [ "document-controller" ],
        "operationId" : "put_1",
        "parameters" : [ {
          "name" : "collection",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "[A-Za-z0-9._:-]{1,200}"
          }
        }, {
          "name" : "documentId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "[A-Za-z0-9._:-]{1,200}"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PutDocumentRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PushResponse"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "document-controller" ],
        "operationId" : "delete",
        "parameters" : [ {
          "name" : "collection",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "[A-Za-z0-9._:-]{1,200}"
          }
        }, {
          "name" : "documentId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "[A-Za-z0-9._:-]{1,200}"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/v1/transform" : {
      "post" : {
        "tags" : [ "chat-controller" ],
        "summary" : "Rewrite the given text following an instruction as a server-sent event stream",
        "operationId" : "transform",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TransformRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Server-sent events. status {requestId, phase: SEARCHING|GENERATING}; token {text}; citations {basis: MARKED|RETRIEVED, items: [{n, documentId, title, url, collection, metadata}]} (chat only); done {refusal, refusalLayer: GATE|MODEL|null, finishReason, truncated, promptTokens, completionTokens}; error {reason: DEADLINE|GENERATION_FAILED|OLLAMA_UNAVAILABLE|MODEL_NOT_AVAILABLE|EMBEDDING_UNAVAILABLE|INTERNAL}. Comment lines are heartbeats. Errors before the stream opens are problem+json: 400, 404, 413 (transform), 429 with Retry-After, 503 (reason OLLAMA_UNAVAILABLE or MODEL_NOT_AVAILABLE).",
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/collections/{collection}/search" : {
      "post" : {
        "tags" : [ "search-controller" ],
        "operationId" : "search",
        "parameters" : [ {
          "name" : "collection",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "[A-Za-z0-9._:-]{1,200}"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SearchRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/collections/{collection}/reindex" : {
      "post" : {
        "tags" : [ "collection-controller" ],
        "operationId" : "reindex",
        "parameters" : [ {
          "name" : "collection",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "[A-Za-z0-9._:-]{1,200}"
          }
        } ],
        "responses" : {
          "202" : {
            "description" : "Accepted",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReindexResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat" : {
      "post" : {
        "tags" : [ "chat-controller" ],
        "summary" : "Answer a question from the given collections as a server-sent event stream",
        "operationId" : "chat",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ChatRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Server-sent events. status {requestId, phase: SEARCHING|GENERATING}; token {text}; citations {basis: MARKED|RETRIEVED, items: [{n, documentId, title, url, collection, metadata}]} (chat only); done {refusal, refusalLayer: GATE|MODEL|null, finishReason, truncated, promptTokens, completionTokens}; error {reason: DEADLINE|GENERATION_FAILED|OLLAMA_UNAVAILABLE|MODEL_NOT_AVAILABLE|EMBEDDING_UNAVAILABLE|INTERNAL}. Comment lines are heartbeats. Errors before the stream opens are problem+json: 400, 404, 413 (transform), 429 with Retry-After, 503 (reason OLLAMA_UNAVAILABLE or MODEL_NOT_AVAILABLE).",
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/clients" : {
      "get" : {
        "tags" : [ "admin-controller" ],
        "operationId" : "list",
        "responses" : {
          "200" : {
